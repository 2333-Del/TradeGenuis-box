# 复制本文件为 docker/.env 并填写真实值（docker/.env 已在 .gitignore，不会提交）。
# Compose 用 -f docker/docker-compose.yml（或 cd docker）启动时，自动读取本目录下的 .env。
# 改完 .env 后需重启容器才生效：docker compose -f docker/docker-compose.yml up -d

# 必改：看板登录密码。不设 = 服务只允许本机访问（容器内等于全部拒绝）
DASHBOARD_PASSWORD=change-me-please
POSTGRES_DB=tradegenuis
POSTGRES_USER=tradegenuis
POSTGRES_PASSWORD=

# 可选：Telegram 推送。留空则读 data/config.json 的 tg_token / tg_chat（无看板输入框，手工编辑文件写入）
TG_BOT_TOKEN=
TG_CHAT_ID=

# 可选：飞书推送（群 -> 设置 -> 群机器人 -> 添加「自定义机器人」拿 Webhook 地址）。
# 安全设置选「签名校验」时把密钥填到 FEISHU_SECRET；选「自定义关键词」建议用"共振"（消息固定含此词）。
# 留空则读 data/config.json 的 feishu_webhook / feishu_secret（无看板输入框，手工编辑文件写入）
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=
