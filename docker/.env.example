# 复制本文件为 docker/.env 并填写真实值（docker/.env 已在 .gitignore，不会提交）。
# Compose 用 -f docker/docker-compose.yml（或 cd docker）启动时，自动读取本目录下的 .env。
# 改完 .env 后需重启容器才生效：docker compose -f docker/docker-compose.yml up -d

# 必改：看板登录密码。不设 = 服务只允许本机访问（容器内等于全部拒绝）
DASHBOARD_PASSWORD=change-me-please
POSTGRES_DB=tradegenuis
POSTGRES_USER=tradegenuis
POSTGRES_PASSWORD=

# 可选：Telegram 推送。留空则用看板 banner 里保存的配置（data/config.json）
TG_BOT_TOKEN=
TG_CHAT_ID=
